{
    "name": "Clash Verge",
    "category": "Utility",
    "noModelConfig": true,
    "apiProtocol": [],
    "docs": "https://www.clashverge.dev/install.html",
    "website": "https://www.clashverge.dev/",
    "configDir": "~/.config/io.github.clash-verge-rev.clash-verge-rev",
    "configFile": "~/.config/io.github.clash-verge-rev.clash-verge-rev/verge.yaml",
    "requireConfigFile": false,
    "paths": {
        "win32": [
            "%ProgramFiles%\\Clash Verge\\Clash Verge.exe",
            "%LOCALAPPDATA%\\Programs\\Clash Verge\\Clash Verge.exe"
        ],
        "darwin": [
            "/Applications/Clash Verge.app/Contents/MacOS/Clash Verge",
            "/Applications/Clash Verge.app/Contents/MacOS/clash-verge"
        ],
        "linux": [
            "/usr/bin/clash-verge",
            "/opt/clash-verge/clash-verge"
        ]
    },
    "installHints": {
        "windowsDisplayNames": [
            "Clash Verge",
            "Clash Verge Rev"
        ],
        "macosAppName": "Clash Verge",
        "linuxDesktopNames": ["Clash Verge"]
    }
}

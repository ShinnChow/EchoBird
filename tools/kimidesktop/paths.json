{
    "name": "Kimi Desktop",
    "names": {
        "zh-Hans": "Kimi 桌面端",
        "zh-Hant": "Kimi 桌面端",
        "ja": "Kimi デスクトップ"
    },
    "category": "Desktop",
    "apiProtocol": ["openai", "anthropic"],
    "docs": "https://www.kimi.com/code/docs/",
    "website": "https://www.kimi.com/code/",
    "description": "Kimi Code Desktop. Kimi CLI and Desktop share ~/.kimi-code/config.toml. Apply & Launch restarts the app; Modify Only requires a manual restart.",
    "command": "",
    "envVar": "KIMI_DESKTOP_PATH",
    "configDir": "~/.kimi-code",
    "configFile": "~/.kimi-code/config.toml",
    "requireConfigFile": false,
    "paths": {
        "win32": ["%LOCALAPPDATA%\\Programs\\Kimi Code\\Kimi Code.exe"],
        "darwin": [
            "/Applications/Kimi Code.app/Contents/MacOS/Kimi Code",
            "~/Applications/Kimi Code.app/Contents/MacOS/Kimi Code"
        ],
        "linux": []
    },
    "installHints": {
        "windowsDisplayNamePrefixes": ["Kimi Code"],
        "macosAppName": "Kimi Code"
    }
}

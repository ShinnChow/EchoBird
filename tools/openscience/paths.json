{
    "name": "OpenScience",
    "category": "Desktop",
    "apiProtocol": [
        "anthropic",
        "openai"
    ],
    "docs": "https://www.openscience.sh/docs",
    "website": "https://www.openscience.sh/download",
    "command": "",
    "configDir": "~/.config/openscience",
    "configFile": "~/.config/openscience/openscience.json",
    "requireConfigFile": false,
    "paths": {
        "win32": [
            "%LOCALAPPDATA%\\Programs\\OpenScience\\openscience.exe",
            "%LOCALAPPDATA%\\Programs\\openscience\\openscience.exe"
        ],
        "darwin": [
            "/Applications/OpenScience.app/Contents/MacOS/OpenScience",
            "~/Applications/OpenScience.app/Contents/MacOS/OpenScience"
        ],
        "linux": [
            "~/.local/bin/OpenScience.AppImage",
            "~/Applications/OpenScience.AppImage"
        ]
    },
    "processNames": {
        "win32": ["openscience.exe"],
        "darwin": ["OpenScience"],
        "linux": ["openscience"]
    },
    "installHints": {
        "windowsDisplayNamePrefixes": ["OpenScience"],
        "macosAppName": "OpenScience",
        "linuxDesktopNames": ["OpenScience"]
    }
}

{
    "name": "DeepSeek Harness",
    "category": "Desktop",
    "noCwdPrompt": true,
    "apiProtocol": [
        "anthropic",
        "openai"
    ],
    "docs": "https://deepseek-harness.github.io/deepseek-harness/",
    "website": "https://www.deepseek.com/harness/",
    "command": "dsh",
    "startCommand": "dsh web",
    "configDir": "~/.dsh",
    "configFile": "~/.dsh/settings.yaml",
    "requireConfigFile": false,
    "paths": {
        "win32": [
            "%APPDATA%\\npm\\dsh.cmd",
            "%APPDATA%\\npm\\dsh"
        ],
        "darwin": [
            "/usr/local/bin/dsh",
            "/opt/homebrew/bin/dsh",
            "~/.npm-global/bin/dsh"
        ],
        "linux": [
            "/usr/local/bin/dsh",
            "/usr/bin/dsh",
            "~/.npm-global/bin/dsh",
            "~/.local/bin/dsh"
        ]
    },
    "installHints": {}
}

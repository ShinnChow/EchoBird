{
    "name": "Pi",
    "category": "CLI Code",
    "apiProtocol": [
        "openai"
    ],
    "docs": "https://pi.dev/docs",
    "website": "https://pi.dev/",
    "command": "pi",
    "startCommand": "pi",
    "configDir": "~/.pi/agent",
    "configFile": "~/.pi/agent/settings.json",
    "requireConfigFile": false,
    "detectByConfigDir": false,
    "paths": {
        "win32": [
            "%APPDATA%\\npm\\pi.cmd",
            "%USERPROFILE%\\.local\\bin\\pi.exe",
            "%USERPROFILE%\\.bun\\bin\\pi.exe",
            "%LOCALAPPDATA%\\pnpm\\pi.exe"
        ],
        "darwin": [
            "/usr/local/bin/pi",
            "/opt/homebrew/bin/pi",
            "~/.bun/bin/pi",
            "~/.local/bin/pi",
            "~/.npm-global/bin/pi",
            "~/Library/pnpm/pi"
        ],
        "linux": [
            "/usr/local/bin/pi",
            "/usr/bin/pi",
            "~/.local/bin/pi",
            "~/.bun/bin/pi",
            "~/.npm-global/bin/pi",
            "~/.local/share/pnpm/pi"
        ]
    }
}
